# CARGOX API — portable image (Render, Fly, Railway, any container host)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8000
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential libpq5 curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# schema + reference seed are idempotent, so this is safe on every boot
CMD ["sh", "-c", "python -m app.db_bootstrap && uvicorn app.main:app --host 0.0.0.0 --port $PORT"]
