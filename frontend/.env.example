# ---------------------------------------------------------------------------
# CARGOX web — Vercel / local environment
# Copy to .env.local for local work. Never commit real values.
# ---------------------------------------------------------------------------

# Server-side rewrite target for /api/backend/*  (the browser never sees this)
# local dev:      http://127.0.0.1:8000
# production:     https://cargox-api.onrender.com
CARGOX_API_URL=http://127.0.0.1:8000

# Google sign-in — the SAME Web client id as the API's GOOGLE_CLIENT_ID.
# Leave blank to run without Google (email + password still works).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: raster tiles for the map. Leave blank to use the bundled offline
# India district basemap. If you set it, keep {z}/{x}/{y} placeholders.
# NEXT_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
