# ---------------------------------------------------------------------------
# CARGOX API — Render / local environment
# Copy to .env for local work (uvicorn reads it with --env-file .env).
# ---------------------------------------------------------------------------

# --- core ------------------------------------------------------------------
CARGOX_SECRET_KEY=change-me-to-a-64-char-random-string
CARGOX_TOKEN_TTL_HOURS=24
CARGOX_PBKDF2_ITERATIONS=120000

# --- persistence -----------------------------------------------------------
# Local (default) uses a SQLite file next to the app:
# CARGOX_DB=./cargox.db
# Production: Supabase Postgres — use the *pooler* string, port 6543
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Admin access ----------------------------------------------------------
# The ONLY predefined account in the product. There are no demo logins.
# Addresses here always land in the Admin dashboard — by Google sign-in or by
# email + CARGOX_ADMIN_PASSWORD. The seeder creates these profiles on first boot.
# Comma separated. Change the password before any public launch:
#   python3 -m app.cli set-admin-password 'a-long-new-password'
CARGOX_ADMIN_EMAILS=mehakdeep.s2006@gmail.com
CARGOX_ADMIN_NAME=Mehakdeep Singh
CARGOX_ADMIN_PASSWORD=mehak@2006

# --- Google sign-in --------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
GOOGLE_CLIENT_ID=
# Optional allow-list, e.g. "yourcompany.com" (blank = any Google account)
GOOGLE_ALLOWED_DOMAINS=

# --- URLs / CORS -----------------------------------------------------------
PUBLIC_WEB_URL=https://your-app.vercel.app
CARGOX_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# --- production posture ----------------------------------------------------
CARGOX_RATE_LIMIT=1
CARGOX_RATE_LIMIT_AUTH=20
CARGOX_RATE_LIMIT_DEFAULT=600
CARGOX_RATE_LIMIT_WINDOW=60

# --- simulation ------------------------------------------------------------
CARGOX_DEFAULT_SEED=20260101
